<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/surface">
        <ImageButton android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/card" android:src="@android:drawable/ic_media_previous" android:contentDescription="@string/back" android:tint="@color/navy" />
        <include layout="@layout/brand_logo" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/save_later" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="Save &amp; Home" android:textColor="@color/red" android:textStyle="bold" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STEP 1 OF 8 · NEW PROPERTY" android:textColor="@color/red" android:textStyle="bold" android:letterSpacing="0" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Requirements &amp; Budget" android:textColor="@color/navy" android:textStyle="bold" android:textSize="34sp" android:fontFamily="@font/finnest_sans" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Shape a plan around what matters to you. Add estimates only where you have them." android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingMultiplier="1.6" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/card" android:padding="16dp" android:text="Planning estimates only. Leave unknown values blank. Loan amounts are not guaranteed and this screen does not determine affordability or approval." android:textColor="@color/navy" android:textSize="14sp" />
            <TextView android:id="@+id/loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="24dp" android:text="Loading your local draft…" android:textColor="@color/muted" />
            <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="@color/surface">
        <com.google.android.material.button.MaterialButton android:id="@+id/back_bottom" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:textSize="14sp" android:letterSpacing="0" android:paddingVertical="12dp" android:text="Back" android:textAllCaps="false" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/next" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="2" android:textSize="14sp" android:letterSpacing="0" android:paddingVertical="12dp" android:text="Save &amp; Continue  →" android:textAllCaps="false" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
